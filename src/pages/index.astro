---
import Layout from "../layouts/Layout.astro";

const title = "Neurofeedback dynamique NeurOptimal® à Nantes et Clisson | NeurOasis";
const description =
  "Séances de neurofeedback dynamique NeurOptimal® à Nantes et Clisson : un entraînement cérébral non invasif au service du bien-être et de l'adaptation face au stress.";
const pagesUrl = "https://thomasrehault-ux.github.io/site-neuroasis-neurofeedback";
const basePath = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();

const healthBusinessJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  name: "NeurOasis",
  description:
    "Séances de neurofeedback dynamique NeurOptimal® à Nantes et Clisson, proposées comme un entraînement cérébral non invasif et une démarche de bien-être.",
  url: pagesUrl,
  image: `${pagesUrl}/images/seance-neurofeedback.jpg`,
  location: [
    {
      "@type": "Place",
      name: "NeurOasis Nantes",
      address: {
        "@type": "PostalAddress",
        streetAddress: "7 rue des Rochettes",
        addressLocality: "Nantes",
        postalCode: "44000",
        addressCountry: "FR",
      },
    },
    {
      "@type": "Place",
      name: "NeurOasis Clisson",
      address: {
        "@type": "PostalAddress",
        streetAddress: "26 rue des Saules",
        addressLocality: "Clisson",
        postalCode: "44190",
        addressCountry: "FR",
      },
    },
  ],
  employee: [
    {
      "@type": "Person",
      name: "Aude Réhault",
      jobTitle: "Psychologue clinicienne – Psychothérapeute",
      url: "https://www.doctolib.fr/psychologue/nantes/aude-rehault",
    },
    {
      "@type": "Person",
      name: "Charles-Antoine Menanteau",
      jobTitle: "Psychologue clinicien – Psychothérapeute",
      url: "https://www.doctolib.fr/psychologue/nantes/charles-antoine-menanteau",
    },
  ],
});

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Le neurofeedback dynamique est-il dangereux ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Le neurofeedback dynamique est présenté comme une méthode fonctionnelle et non invasive : ce sont des capteurs qui lisent l'activité électrique naturelle, mais ils n'envoient aucun courant au cerveau. En cas de doute personnel, n'hésitez pas à demander l'avis de votre médecin.",
      },
    },
    {
      "@type": "Question",
      name: "Combien de séances de neurofeedback faut-il ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "C'est très variable : certaines personnes souhaitent découvrir la méthode sur quelques séances, d'autres préfèrent s'inscrire dans un accompagnement plus progressif. L'idée la plus juste est de raisonner en termes d'évolution au fil du temps, variable selon les objectifs et les ressentis. Le premier rendez-vous avec le psychologue clinicien sert à établir une première base à partir des besoins initiaux.",
      },
    },
    {
      "@type": "Question",
      name: "Le neurofeedback est-il remboursé par la Sécurité sociale ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Les séances ne sont pas prises en charge par l'Assurance Maladie. Certaines complémentaires santé peuvent toutefois prévoir une participation selon leurs contrats : renseignez-vous directement auprès de votre organisme.",
      },
    },
    {
      "@type": "Question",
      name: "Est-ce une méthode médicale ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Non. NeurOptimal® est présenté comme un outil d'entraînement cérébral et de bien-être, pas comme un dispositif destiné à diagnostiquer, traiter ou guérir une maladie. Il peut s'inscrire en complément d'une démarche globale, sans remplacer un suivi médical.",
      },
    },
    {
      "@type": "Question",
      name: "Quelle différence avec la méditation ou la sophrologie ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Contrairement à ces pratiques, le neurofeedback ne repose pas sur une consigne mentale, une respiration spécifique ou un apprentissage conscient. La personne écoute simplement de la musique pendant que le système renvoie des informations auditives très brèves. Les approches peuvent être complémentaires.",
      },
    },
  ],
});
---

<Layout title={title} description={description} lang="fr">
  <Fragment slot="head">
    <meta
      name="keywords"
      content="neurofeedback, neurofeedback dynamique, NeurOptimal®, neurofeedback Nantes, neurofeedback Clisson, entraînement cérébral, bien-être"
    />
    <meta name="author" content="NeurOasis" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pagesUrl} />
    <meta name="theme-color" content="#1a2e1e" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pagesUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${pagesUrl}/images/seance-neurofeedback.jpg`} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="NeurOasis" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Neurofeedback dynamique NeurOptimal® | NeurOasis" />
    <meta
      name="twitter:description"
      content="Retrouvez sérénité, bien-être et performance naturellement avec NeurOptimal® à Nantes et Clisson."
    />
    <meta name="twitter:image" content={`${pagesUrl}/images/seance-neurofeedback.jpg`} />

    <script type="application/ld+json" set:html={healthBusinessJsonLd}></script>
    <script type="application/ld+json" set:html={faqJsonLd}></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <nav id="navbar" role="navigation" aria-label="Navigation principale">
    <a href={`${basePath}/`} class="nav-logo" aria-label="NeurOasis – Accueil">Neur<span>Oasis</span></a>
    <ul class="nav-links">
      <li><a href="#what">Le neurofeedback</a></li>
      <li><a href="#principles">Le fonctionnement</a></li>
      <li><a href="#how">La séance</a></li>
      <li><a href="#forwhom">Pour qui ?</a></li>
      <li><a href="#faq">FAQ</a></li>
      <li><a href="#contact">Contact</a></li>
      <li>
        <a href="#booking" class="nav-cta">Prendre RDV</a>
      </li>
    </ul>
  </nav>

  <header id="hero" role="banner">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="rays" aria-hidden="true">
      <div class="ray"></div><div class="ray"></div><div class="ray"></div>
      <div class="ray"></div><div class="ray"></div><div class="ray"></div><div class="ray"></div>
    </div>
    <div class="trees" aria-hidden="true">
      <svg viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax meet" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="120" cy="300" rx="55" ry="150" fill="#1a2e1e" opacity="0.5"></ellipse>
        <ellipse cx="320" cy="280" rx="45" ry="170" fill="#1a2e1e" opacity="0.4"></ellipse>
        <ellipse cx="1100" cy="290" rx="50" ry="160" fill="#1a2e1e" opacity="0.5"></ellipse>
        <ellipse cx="1300" cy="310" rx="60" ry="140" fill="#1a2e1e" opacity="0.4"></ellipse>
        <ellipse cx="0" cy="360" rx="80" ry="200" fill="#0d1a0f"></ellipse>
        <ellipse cx="200" cy="350" rx="70" ry="210" fill="#0d1a0f"></ellipse>
        <ellipse cx="450" cy="370" rx="90" ry="190" fill="#0d1a0f"></ellipse>
        <ellipse cx="700" cy="355" rx="75" ry="205" fill="#0d1a0f" opacity="0.8"></ellipse>
        <ellipse cx="900" cy="365" rx="85" ry="195" fill="#0d1a0f"></ellipse>
        <ellipse cx="1150" cy="358" rx="78" ry="200" fill="#0d1a0f"></ellipse>
        <ellipse cx="1380" cy="370" rx="90" ry="190" fill="#0d1a0f"></ellipse>
        <ellipse cx="1500" cy="355" rx="70" ry="210" fill="#0d1a0f"></ellipse>
        <rect x="0" y="360" width="1440" height="40" fill="#0d1a0f"></rect>
      </svg>
    </div>
    <div id="particles" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">NeurOptimal® · Nantes & Clisson</p>
      <h1 class="hero-title">
        Retrouvez<br /><em>sérénité, bien-être</em><br />et performance<br />naturellement
      </h1>
      <p class="hero-sub">
        En soutenant les capacités naturelles d'auto-régulation du cerveau, NeurOptimal® favorise un
        meilleur équilibre mental et émotionnel ainsi que l'optimisation des capacités d'adaptation
        face au stress.
      </p>
      <div class="hero-actions">
        <a href="#booking" class="btn-primary">Prendre rendez-vous</a>
        <a href="#what" class="btn-outline">Découvrir</a>
      </div>
    </div>
    <div class="scroll-hint" aria-hidden="true"><div class="scroll-line"></div><span>Défiler</span></div>
  </header>

  <section id="what" aria-labelledby="what-title">
    <div class="what-grid">
      <div class="what-visual" aria-hidden="true">
        <div class="brain-circle"></div><div class="brain-circle"></div>
        <div class="brain-circle"></div><div class="brain-circle"></div>
        <div class="brain-core">🧠</div>
      </div>
      <div>
        <span class="section-tag">Comprendre</span>
        <h2 class="section-title" id="what-title">Qu'est-ce que le<br /><em>neurofeedback dynamique</em> ?</h2>
        <div class="what-cards">
          <div class="what-card">
            <h3>🧬 Un miroir pour votre cerveau</h3>
            <p>
              Des capteurs placés sur le cuir chevelu et les oreilles enregistrent l'activité
              cérébrale naturelle. Ils n'envoient aucun courant : ils lisent simplement le signal et
              permettent au système de le refléter instantanément.
            </p>
          </div>
          <div class="what-card">
            <h3>🌊 L'auto-régulation naturelle</h3>
            <p>
              Quand une variation rapide est détectée, la musique s'interrompt un instant. Ce
              micro-retour agit comme une information immédiate qui laisse au cerveau la possibilité
              de se réorganiser avec plus de souplesse.
            </p>
          </div>
          <div class="what-card">
            <h3>✨ Sans effort, sans diagnostic</h3>
            <p>
              Vous écoutez simplement la séance. Il ne s'agit pas d'établir un diagnostic ni de
              traiter une pathologie précise, mais d'accompagner un travail global de stabilité, de
              flexibilité et de résilience.
            </p>
          </div>
        </div>
        <aside class="method-context" aria-label="Repères sur NeurOptimal®">
          <span>Une pratique internationale</span>
          <p>
            Développé par Zengar® depuis 1996, NeurOptimal® est une neurotechnologie d'entraînement
            cérébral qui s'inscrit dans le champ des neurosciences et s'appuie sur la capacité du
            cerveau à ajuster et réorganiser son activité, associée à la plasticité cérébrale. Le
            système est aujourd'hui présent dans 87 pays.
          </p>
          <a
            href="https://neuroptimal.com/about/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Consulter l'histoire de NeurOptimal® sur le site officiel"
          >
            Source officielle NeurOptimal® →
          </a>
        </aside>
      </div>
    </div>
  </section>

  <section id="principles" aria-labelledby="principles-title">
    <div class="inner">
      <span class="section-tag">Le fonctionnement</span>
      <h2 class="section-title" id="principles-title">Comment agit le<br /><em>neurofeedback dynamique</em> ?</h2>
      <p class="section-lead">
        Pour comprendre la méthode, il suffit de suivre quatre repères simples : mesurer,
        détecter, signaler, puis laisser le cerveau s'ajuster. C'est cette logique qui distingue le
        neurofeedback dynamique d'une approche plus directive ou protocolaire.
      </p>
      <div class="principles-grid">
        <div class="principle-card">
          <h3>1. Mesurer en temps réel</h3>
          <p>
            Le système lit en continu l'activité électrique naturelle du cerveau pendant la séance,
            à partir de capteurs légers posés sur la tête et les oreilles.
          </p>
        </div>
        <div class="principle-card">
          <h3>2. Détecter les variations</h3>
          <p>
            Le logiciel repère les changements rapides dans l'activité cérébrale. Il ne cherche pas
            à imposer un état cible unique, mais observe la dynamique du moment.
          </p>
        </div>
        <div class="principle-card">
          <h3>3. Renvoyer un signal bref</h3>
          <p>
            Lorsqu'une variation est détectée, la musique s'interrompt très brièvement. Ce décalage
            auditif constitue le feedback transmis au cerveau.
          </p>
        </div>
        <div class="principle-card">
          <h3>4. Favoriser l'auto-régulation</h3>
          <p>
            Comme une forme d'entraînement cérébral, le cerveau mobilise ses capacités naturelles
            d'auto-régulation. Informé durant la séance de sa propre activité, il peut ajuster son
            organisation avec davantage de souplesse.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="how" aria-labelledby="how-title">
    <div class="inner">
      <span class="section-tag">La séance</span>
      <h2 class="section-title" id="how-title" style="color:var(--cream)">
        Comment se déroule<br /><em style="color:var(--sage)">une séance ?</em>
      </h2>
      <p class="section-lead">
        Une séance dure 1 heure. Elle est douce, agréable et ne demande aucune préparation
        particulière : la personne s'installe, écoute de la musique et le système fonctionne tout
        seul.
      </p>
      <figure class="session-visual">
        <img
          src={`${basePath}/images/seance-neurofeedback.jpg`}
          alt="Personne installée dans un fauteuil avec des capteurs de neurofeedback sur le cuir chevelu et les oreilles"
          width="1400"
          height="933"
          loading="lazy"
        />
        <figcaption>
          Visuel d'illustration : les capteurs lisent l'activité électrique naturelle sans envoyer
          de courant au cerveau.
        </figcaption>
      </figure>
      <div class="steps">
        <div class="step">
          <div class="step-num" aria-hidden="true">01</div>
          <h3>Accueil & installation</h3>
          <p>
            Vous vous installez confortablement dans un fauteuil. Des capteurs légers sont posés
            sur vos oreilles et votre tête afin de lire l'activité cérébrale naturelle.
          </p>
        </div>
        <div class="step">
          <div class="step-num" aria-hidden="true">02</div>
          <h3>Écoute & feedback</h3>
          <p>
            Vous écoutez de la musique apaisante. Lorsque le système détecte une variation rapide,
            la bande sonore se coupe un très court instant pour renvoyer l'information au cerveau.
          </p>
        </div>
        <div class="step">
          <div class="step-num" aria-hidden="true">03</div>
          <h3>Aucun effort à fournir</h3>
          <p>
            Il n'y a rien à réussir, rien à contrôler. Le cerveau reçoit l'information en temps réel
            et fait son propre travail d'ajustement pendant la séance.
          </p>
        </div>
        <div class="step">
          <div class="step-num" aria-hidden="true">04</div>
          <h3>Progression au fil du temps</h3>
          <p>
            Les ressentis évoluent progressivement selon les personnes. Le suivi sert à observer les
            changements de confort, de récupération, de stabilité ou de concentration.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="forwhom" aria-labelledby="forwhom-title">
    <div class="inner">
      <span class="section-tag">Pour qui ?</span>
      <h2 class="section-title" id="forwhom-title">Le neurofeedback<br />est accessible à <em>tous</em></h2>
      <p class="section-lead">
        Enfants, adolescents, adultes et seniors peuvent découvrir le neurofeedback dynamique dans
        une logique de bien-être, de récupération et d'optimisation du fonctionnement quotidien.
      </p>
      <ul class="audience-list" aria-label="Publics concernés">
        <li>Enfants</li>
        <li>Adolescents</li>
        <li>Adultes</li>
        <li>Seniors</li>
      </ul>
      <p class="forwhom-note">
        NeurOptimal® peut soutenir le développement personnel, l'amélioration des performances
        sportives ainsi que des compétences scolaires et professionnelles. Il peut s'intégrer en
        complément d'une démarche de soin, sans s'y substituer. Les ressentis restent variables
        selon les personnes.
      </p>
      <div class="conditions-grid">
        <div class="condition-card">
          <div class="condition-icon" aria-hidden="true">😮‍💨</div>
          <div>
            <h3>Stress & surcharge</h3>
            <p>
              Quand le système nerveux semble rester en alerte, certaines personnes recherchent
              davantage d'apaisement, de recul et de capacité à récupérer.
            </p>
          </div>
        </div>
        <div class="condition-card">
          <div class="condition-icon" aria-hidden="true">😴</div>
          <div>
            <h3>Sommeil & récupération</h3>
            <p>
              Le travail se fait souvent autour de la qualité du repos, de la détente et de la
              sensation de récupération, sans promettre le traitement d'un trouble médical.
            </p>
          </div>
        </div>
        <div class="condition-card">
          <div class="condition-icon" aria-hidden="true">🎯</div>
          <div>
            <h3>Attention & clarté mentale</h3>
            <p>
              Enfants, adolescents et adultes peuvent rechercher plus de fluidité cognitive, de
              stabilité attentionnelle et de disponibilité mentale.
            </p>
          </div>
        </div>
        <div class="condition-card">
          <div class="condition-icon" aria-hidden="true">🔋</div>
          <div>
            <h3>Fatigue & tension nerveuse</h3>
            <p>
              Dans les périodes d'épuisement, l'objectif est souvent de retrouver un fonctionnement
              plus souple et une meilleure capacité d'adaptation.
            </p>
          </div>
        </div>
        <div class="condition-card">
          <div class="condition-icon" aria-hidden="true">🏆</div>
          <div>
            <h3>Performance & préparation</h3>
            <p>
              Sportifs, artistes ou professionnels peuvent s'y intéresser pour améliorer leur
              présence, leur récupération et leur stabilité sous pression.
            </p>
          </div>
        </div>
        <div class="condition-card">
          <div class="condition-icon" aria-hidden="true">🌱</div>
          <div>
            <h3>Équilibre global</h3>
            <p>
              Il est aussi possible de venir simplement pour mieux se sentir au quotidien, avec plus
              de souplesse, de stabilité et de résilience.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" aria-labelledby="faq-title">
    <div class="inner">
      <span class="section-tag">Questions fréquentes</span>
      <h2 class="section-title" id="faq-title">Vos <em>questions</em>,<br />nos réponses</h2>
      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-a1">
            Le neurofeedback est-il dangereux ?<span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer" id="faq-a1">
            <p>
              Le neurofeedback dynamique est présenté comme une méthode fonctionnelle et non
              invasive : ce sont des capteurs qui lisent l'activité électrique naturelle, mais ils
              n'envoient aucun courant au cerveau. En cas de doute personnel, n'hésitez pas à
              demander l'avis de votre médecin.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-a2">
            Combien de séances sont nécessaires ?<span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer" id="faq-a2">
            <p>
              C'est très variable : certaines personnes souhaitent découvrir la méthode sur quelques
              séances, d'autres préfèrent s'inscrire dans un accompagnement plus progressif. L'idée
              la plus juste est de raisonner en termes d'évolution au fil du temps, variable selon
              les objectifs et les ressentis. Le premier rendez-vous avec le psychologue clinicien
              sert à établir une première base à partir des besoins initiaux.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-a3">
            Le neurofeedback est-il remboursé ?<span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer" id="faq-a3">
            <p>
              Les séances ne sont pas prises en charge par l'Assurance Maladie. Certaines
              complémentaires santé peuvent toutefois prévoir une participation selon leurs
              contrats : renseignez-vous directement auprès de votre organisme.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-a4">
            Est-ce une méthode médicale ?<span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer" id="faq-a4">
            <p>
              Non. NeurOptimal® est présenté comme un outil d'entraînement cérébral et de bien-être,
              pas comme un dispositif destiné à diagnostiquer, traiter ou guérir une maladie. Il
              peut s'inscrire en complément d'une démarche globale, sans remplacer un suivi médical.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-a5">
            Quelle différence avec la méditation ou la sophrologie ?<span
              class="faq-icon"
              aria-hidden="true">+</span
            >
          </button>
          <div class="faq-answer" id="faq-a5">
            <p>
              Contrairement à ces pratiques, le neurofeedback ne repose pas sur une consigne mentale,
              une respiration spécifique ou un apprentissage conscient. La personne écoute
              simplement de la musique pendant que le système renvoie des informations auditives très
              brèves. Les approches peuvent être complémentaires.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="booking" aria-labelledby="booking-title">
    <div class="inner">
      <span class="section-tag">Rendez-vous</span>
      <h2 class="section-title" id="booking-title">
        Commencez votre<br /><em style="color:var(--sage)">voyage intérieur</em>
      </h2>
      <p class="section-lead">
        Prenez rendez-vous directement avec le praticien de votre choix. Ce premier échange permet
