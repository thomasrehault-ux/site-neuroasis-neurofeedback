---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page introuvable | NeurOasis"
  description="La page demandée n'existe pas ou a été déplacée."
  lang="fr"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <main>
    <p class="brand">Neur<span>Oasis</span></p>
    <p class="code">404</p>
    <h1>Cette page est introuvable</h1>
    <p class="message">Le contenu recherché n’existe pas ou a été déplacé.</p>
    <a href="/">Revenir à l’accueil</a>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    color: #20352a;
    background: #f3eee3;
    font-family: "Jost", system-ui, sans-serif;
  }

  main {
    box-sizing: border-box;
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: 2rem;
    text-align: center;
  }

  .brand {
    margin: 0 0 3rem;
    font-family: Georgia, serif;
    font-size: 2rem;
    letter-spacing: 0.04em;
  }

  .brand span {
    color: #4a7a52;
  }

  .code {
    margin: 0;
    color: #4a7a52;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.25em;
  }

  h1 {
    margin: 0.8rem 0 1rem;
    font-family: Georgia, serif;
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    font-weight: 400;
  }

  .message {
    margin: 0 0 2rem;
    color: #5c6d63;
    font-size: 1.1rem;
  }

  a {
    display: inline-block;
    padding: 0.9rem 1.4rem;
    border-radius: 999px;
    color: white;
    background: #4a7a52;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    background: #345b3c;
  }
</style>
